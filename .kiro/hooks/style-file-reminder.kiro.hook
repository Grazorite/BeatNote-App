{
  "enabled": true,
  "name": "Style File Reminder",
  "description": "When a new component is created, checks that a matching style file exists and reminds you to create one if not",
  "version": "1",
  "when": {
    "type": "fileCreated",
    "patterns": [
      "src/components/**/*.tsx",
      "src/features/**/*.tsx"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A new component file was just created. Determine the expected style file path by mirroring the component path under src/styles/ (e.g. src/components/ui/controls/Foo.tsx → src/styles/components/controls/foo.ts). Check if that style file already exists. If it does not exist, remind me to create it and suggest the minimal boilerplate: import { StyleSheet } from 'react-native', import { colors } from '../../../styles/common', and an exported const with StyleSheet.create({})."
  }
}