{
  "enabled": true,
  "name": "Test File Conventions Check",
  "description": "When a test file is saved, reminds you of the right test command and checks for naming convention violations",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "tests/**/*.ts"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A test file was just saved. Check which module it's testing based on the file path and name. If the test file is in tests/unit/, remind me to run `npx jest --testPathPattern=unit --runInBand` to execute the unit tests. If it's a Playwright spec (*.spec.ts), remind me to run `npm test` to run the E2E suite. Also check: does the test follow the naming convention described in testing-strategy.md (behaviour-describing test names, one describe block per module, no test.only or test.skip)? Flag any violations."
  }
}