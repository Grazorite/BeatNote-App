{
  "enabled": true,
  "name": "Update Live Documentation",
  "description": "After a spec task completes, updates the live project documentation to reflect the new state of the codebase",
  "version": "1",
  "when": {
    "type": "postTaskExecution"
  },
  "then": {
    "type": "askAgent",
    "prompt": "A spec task just completed. Review what changed and update the relevant steering files in .kiro/steering/ if the task introduced new architecture, new features, new patterns, or resolved a known limitation. Specifically: (1) if a limitation listed in project-overview.md is now resolved, remove or update it, (2) if a new ADR-worthy decision was made, add it to architecture-decisions.md, (3) if a new iOS feature was implemented, update ios-testflight.md status, (4) if stem separation progress was made, update stem-separation.md. Also update the Roadmap section in README.md to tick off completed items. Only update what actually changed — do not rewrite docs that are still accurate."
  }
}