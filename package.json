{
  "name": "beatnote-app",
  "version": "1.0.0",
  "description": "Local-first music annotation and rehearsal for choreographers and dancers",
  "main": "index.ts",
  "keywords": [
    "audio",
    "annotation",
    "beat-marking",
    "choreography",
    "dance-rehearsal",
    "react-native",
    "expo",
    "typescript",
    "bpm-analysis",
    "waveform"
  ],
  "author": "BeatNote Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Grazorite/BeatNote-App.git"
  },
  "bugs": {
    "url": "https://github.com/Grazorite/BeatNote-App/issues"
  },
  "homepage": "https://github.com/Grazorite/BeatNote-App#readme",
  "scripts": {
    "prestart": "npm run check:version",
    "start": "expo start",
    "preandroid": "npm run check:version",
    "android": "expo run:android",
    "preios": "npm run check:version",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "test:list": "playwright test --list",
    "test:unit": "jest --testPathPatterns=unit --passWithNoTests",
    "perf:projects": "node scripts/generate-performance-projects.js",
    "check:version": "node scripts/check-version-consistency.js",
    "test:ios:ui": "node scripts/ios-ui-test.js"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.37",
    "expo-audio": "~1.1.1",
    "expo-build-properties": "~1.0.10",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-print": "~15.0.8",
    "expo-screen-orientation": "~9.0.9",
    "expo-status-bar": "~3.0.9",
    "lucide-react-native": "^0.554.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.0",
    "fast-check": "^4.5.3",
    "jest": "~29.7.0",
    "ts-jest": "^29.4.6",
    "typescript": "~5.9.2"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  }
}
