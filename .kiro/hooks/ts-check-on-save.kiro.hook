{
  "enabled": true,
  "name": "TypeScript Check on Save",
  "description": "Runs tsc --noEmit after any TypeScript source file is saved to surface type errors immediately",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "src/**/*.ts",
      "src/**/*.tsx"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "npx tsc --noEmit",
    "timeout": 30
  }
}